<Window x:Class="ChatApp.Views.AddContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить контакт" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <TextBlock Grid.Row="0" Text="Поиск пользователей:" FontSize="14" FontWeight="Bold"/>
        <Grid Grid.Row="1" Margin="0,10,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="35" Padding="10"
                     TextChanged="SearchTextBox_TextChanged"/>
            <Button x:Name="SearchButton" Grid.Column="1" Content="Поиск" 
                    Width="80" Height="35" Margin="5,0,0,0"
                    Click="SearchButton_Click"/>
        </Grid>

        <!-- Результаты поиска -->
        <TextBlock Grid.Row="2" Text="Результаты поиска:" FontSize="12" FontWeight="SemiBold"/>
        <ListBox x:Name="SearchResultsListBox" Grid.Row="3" 
                 Margin="0,5,0,15" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="SearchResultsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <!-- Аватар -->
                        <Ellipse Width="40" Height="40" Stroke="Gray" StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Информация о пользователе -->
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding Username}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Email}" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="Green"/>
                        </StackPanel>

                        <!-- Кнопка добавления -->
                        <Button x:Name="AddButton" Content="Добавить" Width="80" Height="25"
                                Margin="20,0,0,0" VerticalAlignment="Center"
                                Tag="{Binding Id}"
                                Click="AddButton_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Закрыть" Width="80" Height="30"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>