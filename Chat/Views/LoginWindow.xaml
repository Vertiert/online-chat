<Window x:Class="ChatApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatApp.Views"
        Title="Вход в чат" Height="500" Width="400" 
        MinHeight="500" MinWidth="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Конвертер для преобразования bool в Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Стиль для TextBox с скругленными углами -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="CaretBrush" Value="#0084ff"/>
            <Setter Property="SelectionBrush" Value="#0084ff" />
            <Setter Property="SelectionOpacity" Value="0.3" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0084ff"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0084ff"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для PasswordBox с скругленными углами -->
        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4"
                                    Padding="12">
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Background="Transparent"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0084ff"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0084ff"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для RadioButton вкладок -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                CornerRadius="7" 
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0084ff"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e7f3ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Эффект тени для кнопок -->
        <DropShadowEffect x:Key="ButtonShadow" 
                          BlurRadius="8" 
                          Opacity="0.2" 
                          ShadowDepth="0" 
                          Color="#0084ff"/>
        <DropShadowEffect x:Key="GreenButtonShadow" 
                          BlurRadius="8" 
                          Opacity="0.2" 
                          ShadowDepth="0" 
                          Color="#27ae60"/>
    </Window.Resources>

    <Grid Background="#f0f2f5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Контентная область -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Width="350">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" 
                           Text="ChatApp" 
                           FontSize="36" 
                           FontWeight="Bold" 
                           Foreground="#0084ff" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"/>

                <!-- Вкладка переключения -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Border Background="White" 
                            CornerRadius="8" 
                            BorderBrush="#ddd" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Вход -->
                            <RadioButton x:Name="LoginTabRadio" 
                                         GroupName="AuthTab" 
                                         IsChecked="True"
                                         Style="{StaticResource TabRadioButtonStyle}">
                                <TextBlock Text="Вход" Margin="10"/>
                            </RadioButton>

                            <!-- Регистрация -->
                            <RadioButton Grid.Column="1" 
                                         x:Name="RegisterTabRadio" 
                                         GroupName="AuthTab"
                                         Style="{StaticResource TabRadioButtonStyle}">
                                <TextBlock Text="Регистрация" Margin="10"/>
                            </RadioButton>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Панель Входа (видима когда LoginTabRadio.IsChecked == true) -->
                <StackPanel Grid.Row="2" 
                            Visibility="{Binding IsChecked, ElementName=LoginTabRadio, Converter={StaticResource BoolToVis}}">
                    <!-- Email -->
                    <TextBlock Text="Email:" 
                               Margin="0,0,0,5" 
                               Foreground="#333" 
                               FontSize="14"/>
                    <TextBox x:Name="EmailTextBox" 
                             Style="{StaticResource RoundedTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль:" 
                               Margin="0,0,0,5" 
                               Foreground="#333" 
                               FontSize="14"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                 Margin="0,0,0,20"/>

                    <!-- Сообщение об ошибке входа -->
                    <TextBlock x:Name="LoginErrorText" 
                               Foreground="#e74c3c" 
                               FontSize="13" 
                               TextWrapping="Wrap"
                               Visibility="Collapsed" 
                               Margin="0,0,0,15"/>

                    <!-- Кнопка входа -->
                    <Button Content="Войти" 
                            Background="#0084ff" 
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="LoginButton_Click">
                        <Button.Effect>
                            <StaticResource ResourceKey="ButtonShadow"/>
                        </Button.Effect>
                    </Button>

                    <!-- Восстановление пароля -->
                    <Button Content="Забыли пароль?" 
                            Background="Transparent" 
                            Foreground="#666" 
                            Height="30" 
                            FontSize="13" 
                            BorderThickness="0"
                            Click="ForgotPasswordButton_Click" 
                            Cursor="Hand"
                            Margin="0,15,0,0"/>
                </StackPanel>

                <!-- Панель Регистрации (видима когда RegisterTabRadio.IsChecked == true) -->
                <StackPanel Grid.Row="2" 
                            Visibility="{Binding IsChecked, ElementName=RegisterTabRadio, Converter={StaticResource BoolToVis}}">
                    <!-- Email -->
                    <TextBlock Text="Email:" 
                               Margin="0,0,0,5" 
                               Foreground="#333" 
                               FontSize="14"/>
                    <TextBox x:Name="RegisterEmailTextBox" 
                             Style="{StaticResource RoundedTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <!-- Имя пользователя -->
                    <TextBlock Text="Имя пользователя:" 
                               Margin="0,0,0,5" 
                               Foreground="#333" 
                               FontSize="14"/>
                    <TextBox x:Name="UsernameTextBox" 
                             Style="{StaticResource RoundedTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль:" 
                               Margin="0,0,0,5" 
                               Foreground="#333" 
                               FontSize="14"/>
                    <PasswordBox x:Name="RegisterPasswordBox" 
                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                 Margin="0,0,0,15"/>

                    <!-- Подтверждение пароля -->
                    <TextBlock Text="Подтвердите пароль:" 
                               Margin="0,0,0,5" 
                               Foreground="#333" 
                               FontSize="14"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" 
                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                 Margin="0,0,0,20"/>

                    <!-- Сообщение об ошибке регистрации -->
                    <TextBlock x:Name="RegisterErrorText" 
                               Foreground="#e74c3c" 
                               FontSize="13" 
                               TextWrapping="Wrap"
                               Visibility="Collapsed" 
                               Margin="0,0,0,15"/>

                    <!-- Кнопка регистрации -->
                    <Button Content="Создать аккаунт" 
                            Background="#27ae60" 
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="RegisterButton_Click">
                        <Button.Effect>
                            <StaticResource ResourceKey="GreenButtonShadow"/>
                        </Button.Effect>
                    </Button>

                    <!-- Кнопка возврата к входу -->
                    <Button Content="← Вернуться к входу" 
                            Background="Transparent" 
                            Foreground="#666" 
                            Height="30" 
                            FontSize="13" 
                            BorderThickness="0"
                            Click="BackToLoginButton_Click" 
                            Cursor="Hand"
                            Margin="0,15,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>