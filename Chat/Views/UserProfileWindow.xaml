<Window x:Class="ChatApp.Views.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль пользователя" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Аватар -->
        <Ellipse Grid.Row="0" Width="120" Height="120" Stroke="Gray" StrokeThickness="2"
                 HorizontalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush x:Name="UserAvatarImage" Stretch="UniformToFill"/>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Имя пользователя -->
        <TextBlock Grid.Row="1" Text="Имя пользователя:" Margin="0,20,0,5" FontSize="14"/>
        <TextBlock x:Name="UsernameText" Grid.Row="2" FontSize="16" FontWeight="Bold"/>

        <!-- Статус -->
        <TextBlock Grid.Row="3" Text="Статус:" Margin="0,15,0,5" FontSize="14"/>
        <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="14"/>

        <!-- Био -->
        <TextBlock Grid.Row="5" Text="О себе:" Margin="0,15,0,5" FontSize="14"/>
        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Height="100" Margin="0,0,0,20">
            <TextBlock x:Name="BioText" TextWrapping="Wrap" FontSize="14"/>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="7" Content="Закрыть" Width="100" Height="30" 
                HorizontalAlignment="Right" Margin="0,10,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>