<Window x:Class="ChatApp.Views.NotificationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки уведомлений" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- Основные настройки -->
                <GroupBox Header="Основные настройки">
                    <StackPanel>
                        <CheckBox x:Name="EnabledCheckBox" 
                                  Content="Включить уведомления"
                                  IsChecked="True"/>

                        <CheckBox x:Name="ShowPreviewCheckBox" 
                                  Content="Показывать превью сообщений"
                                  IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Звук -->
                <GroupBox Header="Звук">
                    <StackPanel>
                        <CheckBox x:Name="PlaySoundCheckBox" 
                                  Content="Воспроизводить звук"
                                  IsChecked="True"/>

                        <CheckBox x:Name="OnlyBannerCheckBox" 
                                  Content="Только баннер (без звука)"
                                  IsChecked="False"/>
                    </StackPanel>
                </GroupBox>

                <!-- Умные уведомления -->
                <GroupBox Header="Умные уведомления">
                    <StackPanel>
                        <CheckBox x:Name="SmartNotificationsCheckBox" 
                                  Content="Не показывать, если я активен в диалоге"
                                  IsChecked="True"
                                  ToolTip="Уведомления не будут показываться, если вы находитесь в активном чате с отправителем"/>

                        <TextBlock Text="Когда включено, уведомления не будут показываться, если вы уже общаетесь с этим человеком"
                                   TextWrapping="Wrap"
                                   Margin="10,5"
                                   FontSize="11"
                                   Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,20">
                    <Button x:Name="TestButton" 
                            Content="Тест"
                            Width="80" 
                            Height="30" 
                            Margin="0,0,10,0"
                            Click="TestButton_Click"
                            ToolTip="Показать тестовое уведомление"/>

                    <Button x:Name="SaveButton" 
                            Content="Сохранить"
                            Width="80" 
                            Height="30" 
                            Margin="0,0,10,0"
                            Click="SaveButton_Click"/>

                    <Button x:Name="CancelButton" 
                            Content="Отмена"
                            Width="80" 
                            Height="30" 
                            Click="CancelButton_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>