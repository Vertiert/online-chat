<Window x:Class="ChatApp.Views.ChangeEmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена Email" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Смена Email" 
                   FontSize="16" FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <!-- Текущий email -->
        <TextBlock Grid.Row="1" Text="Текущий email:" 
                   FontSize="12" Margin="0,0,0,5"/>
        <TextBlock x:Name="CurrentEmailTextBlock" Grid.Row="1" 
                   Text="" FontWeight="Bold"
                   HorizontalAlignment="Right"/>

        <!-- Новый email -->
        <TextBlock Grid.Row="2" Text="Новый email:" 
                   FontSize="12" Margin="0,10,0,5"/>
        <TextBox x:Name="NewEmailTextBox" Grid.Row="2" 
                 Height="30" Padding="5"
                 Margin="0,0,0,10"/>

        <!-- Пароль для подтверждения -->
        <TextBlock Grid.Row="3" Text="Пароль для подтверждения:" 
                   FontSize="12" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" 
                     Height="30" Padding="5"
                     Margin="0,0,0,20"/>

        <!-- Сообщения об ошибках -->
        <TextBlock x:Name="ErrorMessageTextBlock" Grid.Row="4" 
                   Text="" Foreground="Red" 
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Отмена" 
                    Width="80" Height="30" Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Сохранить" 
                    Width="80" Height="30"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>